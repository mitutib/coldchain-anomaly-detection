{
  "uid": "coldchain",
  "title": "Coldchain",
  "tags": [
    "coldchain"
  ],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Readings per second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(coldchain_readings_total[$__rate_interval]))",
          "legendFormat": "readings"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alarm starts per 1000 readings",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum(increase(coldchain_alarm_starts_total[$__rate_interval])) / sum(increase(coldchain_readings_total[$__rate_interval]))",
          "legendFormat": "alarm starts"
        }
      ],
      "description": "Tuned rate is about 2. The drift alert fires above 4."
    },
    {
      "id": 3,
      "title": "Share of readings in alarm",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(coldchain_alarms_total[$__rate_interval])) / sum(rate(coldchain_readings_total[$__rate_interval]))",
          "legendFormat": "in alarm"
        }
      ]
    },
    {
      "id": 4,
      "title": "Scoring time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coldchain_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(coldchain_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 5,
      "title": "Reading minus setpoint",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(coldchain_reading_offset_degrees_bucket[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "description": "The input distribution. A band that widens or moves is drift.",
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "celsius"
        }
      }
    },
    {
      "id": 6,
      "title": "Store errors and replicas",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(coldchain_store_errors_total[$__rate_interval]))",
          "legendFormat": "store errors per second"
        },
        {
          "refId": "B",
          "expr": "sum(up{job=\"coldchain\"})",
          "legendFormat": "replicas up"
        }
      ]
    }
  ]
}